---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ColorScript from "../components/ColorScript.astro";
import Tags from "../components/Tags.astro";
import getTags from "../scripts/getTags";

const posts = await getCollection("posts");
const allTags = getTags(posts);

// Extract props safely from frontmatter, content, or root props
const { frontmatter, content } = Astro.props;
const data = frontmatter || content || Astro.props;

const title = data.title || Astro.props.title;
const description = data.description || Astro.props.description;
const headerTitle = data.headerTitle;
const headerSubtitle = data.headerSubtitle;
const heroImage = data.heroImage;
const tags = data.tags;

// Safely format dates if available
let added = data.added ? new Date(data.added).toLocaleDateString("en-us", {
	year: "numeric",
	month: "short",
	day: "numeric",
}) : null;

let updated = data.updated ? new Date(data.updated).toLocaleDateString("en-us", {
	year: "numeric",
	month: "short",
	day: "numeric",
}) : null;
---

<html lang="en-us">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header title={headerTitle} subtitle={headerSubtitle} />
		<main>
			<article>
				{heroImage && <img width={720} height={360} src={heroImage} alt="" />}
				{title && <h1 class="article-title">{title}</h1>}
				{updated ? (
					<span><time>{added}</time>, last updated on <time>{updated}</time></span>
				) : (
					<span>{added && <time>{added}</time>}</span>
				)}
				{tags && <Tags tags={tags} />}
				<hr />
				<div class="blog-post">
					<slot />
				</div>
				<!-- Share on LinkedIn Button -->
				<div class="share-container" style="margin-top: 2em; padding-top: 1em; border-top: 1px dashed #ccc;">
					<a 
						href={`https://www.linkedin.com/sharing/share-offsite/?url=https://abdulmuqsit.dev/post/${Astro.params.slug}`} 
						target="_blank" 
						rel="noopener noreferrer" 
						style="font-weight: bold; color: #16a34a; text-decoration: underline;"
					>
						Share this post on LinkedIn ↗
					</a>
				</div>
			</article>
		</main>
		<Tags tags={allTags} all />
		<Footer />
		<ColorScript />
	</body>
</html>